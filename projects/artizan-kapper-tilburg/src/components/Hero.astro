---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.jpg';
import { strings, hasSection, telHref } from '../config';

interface Props {
  label?: string;
  heading: string;
  sub: string;
  phone?: string;
}

const { label, heading, sub, phone } = Astro.props;

// Secondary CTA points at hours if that section exists, otherwise contact —
// never at a section that isn't rendered.
const secondaryHref = hasSection('hours')
  ? '#hours'
  : hasSection('contact')
    ? '#contact'
    : null;
---

<section id="top" class="hero section">
  <div class="container hero-inner">
    <div class="hero-copy">
      {label && <span class="eyebrow">{label}</span>}
      <h1>{heading}</h1>
      <p class="lead">{sub}</p>

      <div class="hero-ctas">
        {
          phone && (
            <a class="btn btn-primary" href={telHref(phone)}>
              {strings.primaryCta}
            </a>
          )
        }
        {
          secondaryHref && (
            <a class="btn btn-secondary" href={secondaryHref}>
              {strings.secondaryCta}
            </a>
          )
        }
      </div>
    </div>

    <div class="hero-visual">
      <Image
        src={heroImage}
        alt="Interieur van een herenkapperszaak met barbierstoelen, spiegels en een bakstenen muur onder warm hanglicht."
        widths={[400, 800, 1200]}
        sizes="(min-width: 900px) 50vw, 100vw"
      />
      <p class="visual-caption">
        Sfeerbeeld — wordt vervangen zodra er eigen foto's van de zaak zijn
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(
        60% 60% at 85% 0%,
        color-mix(in srgb, var(--color-accent) 14%, transparent),
        transparent 70%
      ),
      var(--color-bg);
  }

  .hero-inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    max-width: 1100px;
  }

  .hero-visual img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    display: block;
  }

  .visual-caption {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
