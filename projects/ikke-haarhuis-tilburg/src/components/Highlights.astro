---
import { strings } from '../config';

interface Props {
  heading?: string;
  items?: { icon?: string; title: string; body: string }[];
}

const { heading, items = [] } = Astro.props;
---

{
  items.length > 0 && (
    <section id="highlights" class="section section-alt">
      <div class="container">
        <h2>{heading ?? strings.highlightsHeading}</h2>
        <ul class="highlight-grid">
          {items.map((item) => (
            <li class="card reveal">
              {item.icon && (
                <span class="highlight-icon" aria-hidden="true">
                  {item.icon}
                </span>
              )}
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .highlight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .highlight-grid p {
    margin-bottom: 0;
  }

  .highlight-icon {
    display: inline-block;
    font-size: 1.6rem;
    margin-bottom: 0.75rem;
  }
</style>
