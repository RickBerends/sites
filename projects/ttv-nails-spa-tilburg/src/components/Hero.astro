---
import { strings, hasSection, telHref } from '../config';

interface Props {
  label?: string;
  heading: string;
  sub: string;
  phone?: string;
}

const { label, heading, sub, phone } = Astro.props;

// Secondary CTA points at hours if that section exists, otherwise contact —
// never at a section that isn't rendered.
const secondaryHref = hasSection('hours')
  ? '#hours'
  : hasSection('contact')
    ? '#contact'
    : null;
---

<section id="top" class="hero section">
  <div class="container hero-inner">
    <div class="hero-copy">
      {label && <span class="eyebrow">{label}</span>}
      <h1>{heading}</h1>
      <p class="lead">{sub}</p>

      <div class="hero-ctas">
        {
          phone && (
            <a class="btn btn-primary" href={telHref(phone)}>
              {strings.primaryCta}
            </a>
          )
        }
        {
          secondaryHref && (
            <a class="btn btn-secondary" href={secondaryHref}>
              {strings.secondaryCta}
            </a>
          )
        }
      </div>
    </div>

    <div class="hero-visual" role="presentation" aria-hidden="true">
      <div class="hero-visual-rings"></div>
      <div class="hero-visual-glow hero-visual-glow--a"></div>
      <div class="hero-visual-glow hero-visual-glow--b"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(
        60% 60% at 85% 0%,
        color-mix(in srgb, var(--color-accent) 14%, transparent),
        transparent 70%
      ),
      var(--color-bg);
  }

  .hero-inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    max-width: 1100px;
  }

  .hero-copy {
    order: 2;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  /* Crafted CSS visual — a calm, spa-like ripple built from identity-B accent
     tokens. No stock photo of this salon exists, so this replaces the image
     slot rather than leaving it empty or reusing an unrelated stock photo. */
  .hero-visual {
    order: 1;
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: linear-gradient(
      155deg,
      color-mix(in srgb, var(--color-accent) 14%, var(--color-bg)) 0%,
      var(--color-surface) 52%,
      color-mix(in srgb, var(--color-accent-alt) 18%, var(--color-bg)) 100%
    );
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--color-border);
  }

  .hero-visual-rings {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 50% 50%,
        transparent 0 17%,
        color-mix(in srgb, var(--color-accent) 30%, transparent) 17.4% 18%,
        transparent 18.4%
      ),
      radial-gradient(
        circle at 50% 50%,
        transparent 0 29%,
        color-mix(in srgb, var(--color-accent-alt) 26%, transparent) 29.4% 30%,
        transparent 30.4%
      ),
      radial-gradient(
        circle at 50% 50%,
        transparent 0 41%,
        color-mix(in srgb, var(--color-accent) 20%, transparent) 41.4% 42%,
        transparent 42.4%
      );
  }

  .hero-visual-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(46px);
  }

  .hero-visual-glow--a {
    width: 42%;
    aspect-ratio: 1;
    top: -10%;
    right: -8%;
    background: color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .hero-visual-glow--b {
    width: 34%;
    aspect-ratio: 1;
    bottom: -8%;
    left: -6%;
    background: color-mix(in srgb, var(--color-accent-alt) 40%, transparent);
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .hero-copy {
      order: 1;
    }

    .hero-visual {
      order: 2;
    }
  }
</style>
