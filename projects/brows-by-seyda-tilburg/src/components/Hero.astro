---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { strings, hasSection, telHref } from '../config';

interface Props {
  label?: string;
  heading: string;
  sub: string;
  phone?: string;
  instagramUrl?: string;
  image?: ImageMetadata;
}

const { label, heading, sub, phone, instagramUrl, image } = Astro.props;

// Secondary CTA points at hours if that section exists, then contact, then
// falls back to Instagram (the only booking channel this business has) —
// never at a section that isn't rendered.
const secondaryHref = hasSection('hours')
  ? '#hours'
  : hasSection('contact')
    ? '#contact'
    : instagramUrl
      ? instagramUrl
      : null;
const secondaryIsExternal = secondaryHref === instagramUrl;
---

<section id="top" class="hero section">
  <div class="container hero-inner">
    <div class="hero-visual">
      {
        image ? (
          <Image src={image} alt={heading} widths={[400, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" />
        ) : (
          // No real photo sourced yet, and no confidently-licensed stock match
          // for a brow salon existed in the offline mock library — a crafted
          // CSS placeholder in this project's own identity-B accent tokens
          // fills the slot instead. TODO: replace with a real photo of the
          // salon/treatments before launch.
          <div class="visual-placeholder" role="img" aria-label="" />
        )
      }
      {!image && <p class="visual-caption">{strings.stockImageCaption}</p>}
    </div>

    <div class="hero-copy">
      {label && <span class="eyebrow">{label}</span>}
      <h1>{heading}</h1>
      <p class="lead">{sub}</p>

      <div class="hero-ctas">
        {
          phone && (
            <a class="btn btn-primary" href={telHref(phone)}>
              {strings.primaryCta}
            </a>
          )
        }
        {
          secondaryHref && (
            <a
              class="btn btn-secondary"
              href={secondaryHref}
              target={secondaryIsExternal ? '_blank' : undefined}
              rel={secondaryIsExternal ? 'noopener noreferrer' : undefined}
            >
              {strings.secondaryCta}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(
        60% 60% at 85% 0%,
        color-mix(in srgb, var(--color-accent) 14%, transparent),
        transparent 70%
      ),
      var(--color-bg);
  }

  .hero-inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    max-width: 1100px;
  }

  .hero-visual img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    display: block;
  }

  /* Restrained placeholder: two soft accent washes over the identity's own
     surface tone, framed by a single asymmetric arch — a quiet nod to a brow
     line without being a literal icon. Built entirely from this project's
     identity-B tokens so it always matches, even if the accent is overridden. */
  .visual-placeholder {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    background:
      radial-gradient(
        120% 140% at 12% 8%,
        color-mix(in srgb, var(--color-accent) 36%, transparent),
        transparent 60%
      ),
      radial-gradient(
        100% 120% at 92% 96%,
        color-mix(in srgb, var(--color-accent-alt) 30%, transparent),
        transparent 65%
      ),
      linear-gradient(155deg, var(--color-surface) 0%, var(--color-bg) 100%);
  }

  .visual-placeholder::after {
    content: '';
    position: absolute;
    inset: 13%;
    border: 1px solid color-mix(in srgb, var(--color-accent) 38%, transparent);
    border-radius: 62% 38% 55% 45% / 45% 55% 40% 60%;
  }

  .visual-caption {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
