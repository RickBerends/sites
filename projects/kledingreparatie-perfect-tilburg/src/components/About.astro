---
import { Image } from 'astro:assets';
import aboutImage from '../assets/about.jpg';

interface Props {
  heading: string;
  body: string;
  address?: string;
}

const { heading, body } = Astro.props;
---

<section id="over-ons" class="about">
  <div class="container about__inner">
    <div class="about__visual reveal">
      <Image
        src={aboutImage}
        alt="Kleermaker past een lap tweedstof op een werktafel, met een meetlint om de nek en stoffen op de achtergrond"
        widths={[400, 800, 1000]}
        sizes="(min-width: 768px) 40vw, 100vw"
      />
      <p class="about__caption">Sfeerbeeld — wordt vervangen zodra er eigen foto's van de zaak zijn</p>
    </div>
    <div class="about__text reveal">
      <span class="eyebrow">Over ons</span>
      <h2>{heading}</h2>
      <p class="text-secondary">{body}</p>
    </div>
  </div>
</section>

<style>
  .about__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .about__visual img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-subtle);
    display: block;
  }

  .about__caption {
    margin-top: 0.6rem;
    font-size: 0.78rem;
    color: var(--color-text-secondary);
  }

  .about__text h2 {
    max-width: 22ch;
  }

  .about__text p {
    max-width: 60ch;
    font-size: 1.02rem;
  }

  @media (min-width: 768px) {
    .about__inner {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
</style>
