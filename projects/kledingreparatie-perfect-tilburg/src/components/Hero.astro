---
interface Props {
  label: string;
  heading: string;
  sub: string;
  phone?: string;
}

const { label, heading, sub, phone } = Astro.props;
---

<section id="top" class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="eyebrow">{label}</span>
      <h1 class="hero__heading">{heading}</h1>
      <p class="hero__sub text-secondary">{sub}</p>
      <div class="hero__ctas">
        {phone && (
          <a class="btn btn-primary" href={`tel:${phone.replace(/\s+/g, '')}`}>
            Bel nu — {phone}
          </a>
        )}
        <a class="btn btn-secondary" href="#openingstijden">Bekijk openingstijden</a>
      </div>
    </div>
    <div class="hero__visual" aria-hidden="true">
      <span class="hero__visual-frame"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 96px;
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .hero__copy {
    max-width: 560px;
  }

  .hero__heading {
    font-size: clamp(2rem, 5vw, 3.25rem);
    letter-spacing: -0.01em;
  }

  .hero__sub {
    font-size: 1.15rem;
    max-width: 52ch;
    margin-bottom: 2rem;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  /* Crafted CSS visual — no stock photo exists for the workshop yet, so this
     stands in for one: a two-tone accent panel with a fine woven crosshatch
     (evokes fabric weave) and a dashed stitch-line frame (evokes a tailor's
     chalk/pattern marks). Built only from the identity's own tokens —
     restrained, no icons, no borrowed imagery. */
  .hero__visual {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: linear-gradient(155deg, var(--color-accent-alt) 0%, var(--color-accent) 100%);
    box-shadow: var(--shadow-subtle);
  }

  .hero__visual::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        45deg,
        rgba(255, 255, 255, 0.07) 0px,
        rgba(255, 255, 255, 0.07) 1px,
        transparent 1px,
        transparent 9px
      ),
      repeating-linear-gradient(
        -45deg,
        rgba(255, 255, 255, 0.05) 0px,
        rgba(255, 255, 255, 0.05) 1px,
        transparent 1px,
        transparent 9px
      );
  }

  .hero__visual-frame {
    position: absolute;
    inset: 22px;
    border: 1.5px dashed rgba(255, 255, 255, 0.35);
    border-radius: calc(var(--radius-card) - 6px);
  }

  @media (min-width: 768px) {
    .hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
