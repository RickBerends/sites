---
interface Props {
  label: string;
  heading: string;
  sub: string;
  phone?: string;
}

const { label, heading, sub, phone } = Astro.props;
---

<section id="top" class="hero">
  <div class="container hero__inner">
    <span class="eyebrow">{label}</span>
    <h1 class="hero__heading">{heading}</h1>
    <p class="hero__sub text-secondary">{sub}</p>
    <div class="hero__ctas">
      {phone && (
        <a class="btn btn-primary" href={`tel:${phone.replace(/\s+/g, '')}`}>
          Bel nu — {phone}
        </a>
      )}
      <a class="btn btn-secondary" href="#openingstijden">Bekijk openingstijden</a>
    </div>
  </div>
  <div class="hero__texture" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 96px;
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }

  .hero__heading {
    font-size: clamp(2rem, 5vw, 3.25rem);
    letter-spacing: -0.01em;
  }

  .hero__sub {
    font-size: 1.15rem;
    max-width: 52ch;
    margin-bottom: 2rem;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  /* Restrained decorative texture — stitched-thread motif rather than a
     stock photo we don't have the rights or facts to use. */
  .hero__texture {
    position: absolute;
    inset: auto -10% -30% auto;
    width: 60%;
    aspect-ratio: 1;
    background:
      repeating-linear-gradient(
        135deg,
        rgba(91, 124, 111, 0.10) 0px,
        rgba(91, 124, 111, 0.10) 2px,
        transparent 2px,
        transparent 18px
      );
    border-radius: 50%;
    filter: blur(0.5px);
    z-index: 0;
  }
</style>
