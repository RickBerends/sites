---
const links = [
  { href: '#diensten', label: 'Diensten' },
  { href: '#over-ons', label: 'Over ons' },
  { href: '#openingstijden', label: 'Openingstijden' },
  { href: '#contact', label: 'Contact' },
];
const phone = Astro.props.phone as string | undefined;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="#top" class="site-header__brand">Kledingreparatie Perfect</a>
    <nav class="site-header__nav" aria-label="Hoofdnavigatie">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    {phone && (
      <a class="btn btn-primary site-header__cta" href={`tel:${phone.replace(/\s+/g, '')}`}>
        Bel nu
      </a>
    )}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(247, 245, 242, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 24px;
  }

  .site-header__brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .site-header__nav {
    display: none;
    gap: 1.75rem;
    font-size: 0.92rem;
  }

  .site-header__nav a {
    text-decoration: none;
    color: var(--color-text-secondary);
    transition: color var(--motion-duration) var(--motion-easing);
  }

  .site-header__nav a:hover {
    color: var(--color-accent);
  }

  .site-header__cta {
    padding: 0.6em 1.1em;
    font-size: 0.88rem;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .site-header__nav {
      display: flex;
    }
  }
</style>
