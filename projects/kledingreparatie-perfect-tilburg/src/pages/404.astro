---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Pagina niet gevonden — Kledingreparatie Perfect"
  description="Deze pagina bestaat niet. Ga terug naar de homepage van Kledingreparatie Perfect in Tilburg."
>
  <main class="not-found">
    <div class="container not-found__inner">
      <span class="eyebrow">404</span>
      <h1>Deze pagina is los geraakt</h1>
      <p class="text-secondary">
        Net als een missende knoop is deze pagina zoek. Ga terug naar de
        homepage om onze diensten en openingstijden te bekijken.
      </p>
      <a class="btn btn-primary" href={base}>Terug naar de homepage</a>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .not-found__inner {
    max-width: 520px;
    text-align: left;
  }

  .not-found__inner p {
    margin-bottom: 2rem;
  }
</style>
