---
import { strings, hasSection, telHref } from '../config';

interface Props {
  label?: string;
  heading: string;
  sub: string;
  phone?: string;
}

const { label, heading, sub, phone } = Astro.props;

// Secondary CTA points at hours if that section exists, otherwise contact —
// never at a section that isn't rendered.
const secondaryHref = hasSection('hours')
  ? '#hours'
  : hasSection('contact')
    ? '#contact'
    : null;
---

<section id="top" class="hero section">
  <div class="container hero-inner">
    <div class="hero-copy">
      {label && <span class="eyebrow">{label}</span>}
      <h1>{heading}</h1>
      <p class="lead">{sub}</p>

      <div class="hero-ctas">
        {
          phone && (
            <a class="btn btn-primary" href={telHref(phone)}>
              {strings.primaryCta}
            </a>
          )
        }
        {
          secondaryHref && (
            <a class="btn btn-secondary" href={secondaryHref}>
              {strings.secondaryCta}
            </a>
          )
        }
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <span class="hero-visual-pattern"></span>
      <span class="hero-mark">RI</span>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(
        60% 60% at 85% 0%,
        color-mix(in srgb, var(--color-accent) 14%, transparent),
        transparent 70%
      ),
      var(--color-bg);
  }

  .hero-inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    max-width: 1100px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  /* No second real photo exists for this studio, and reusing the About photo
     here would repeat imagery of a different studio twice on one page. A
     crafted, ink-dark panel stands in instead: a fine stipple texture (the
     shading technique tattooing is built on) and the studio's initials as a
     restrained mark, built entirely from this identity's own accent tokens. */
  .hero-visual {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: radial-gradient(
      130% 130% at 15% 0%,
      color-mix(in srgb, var(--color-accent) 40%, var(--color-accent-alt)) 0%,
      var(--color-accent-alt) 45%,
      #0f1319 100%
    );
    box-shadow: var(--shadow-soft);
  }

  .hero-visual::after {
    content: '';
    position: absolute;
    inset: 14px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: calc(var(--radius-card) - 6px);
  }

  .hero-visual-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.12) 1px, transparent 0);
    background-size: 18px 18px;
    opacity: 0.6;
  }

  .hero-mark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: clamp(4rem, 13vw, 7.5rem);
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.16);
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
