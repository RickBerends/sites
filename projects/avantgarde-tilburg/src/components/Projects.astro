---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { strings } from '../config';

interface Props {
  heading?: string;
  items?: { title: string; location?: string; body?: string; image: ImageMetadata }[];
}

const { heading, items = [] } = Astro.props;
---

{
  items.length > 0 && (
    <section id="projects" class="section">
      <div class="container">
        <h2>{heading ?? strings.projectsHeading}</h2>
        <ul class="project-grid">
          {items.map((item) => (
            <li class="project-card reveal">
              <Image
                src={item.image}
                alt={item.title}
                widths={[400, 800, 1200]}
                sizes="(min-width: 900px) 50vw, 100vw"
              />
              <div class="project-caption">
                <h3>{item.title}</h3>
                {item.location && <p class="project-location">{item.location}</p>}
                {item.body && <p>{item.body}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .project-card img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    display: block;
  }

  .project-caption {
    margin-top: 0.9rem;
  }

  .project-caption h3 {
    margin-bottom: 0.2rem;
  }

  .project-caption p {
    margin-bottom: 0;
  }

  .project-location {
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
