---
interface Props {
  label?: string;
  heading: string;
  sub: string;
  instagramUrl?: string;
}
const { label, heading, sub, instagramUrl } = Astro.props;
---
<section id="top" class="hero">
  <div class="container fade-up">
    {label && <p class="label">{label}</p>}
    <h1>{heading}</h1>
    <p class="hero-sub">{sub}</p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="#contact">Neem contact op</a>
      {instagramUrl && (
        <a class="btn btn-secondary" href={instagramUrl} target="_blank" rel="noopener noreferrer">
          Bekijk Instagram
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 96px;
  }
  .hero-sub {
    max-width: 42ch;
    font-size: 1.1rem;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 1.5em;
  }
</style>
