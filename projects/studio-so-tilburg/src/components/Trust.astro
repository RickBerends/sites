---
interface Props {
  items?: string[];
}
const { items } = Astro.props;
---
{items && items.length > 0 && (
  <section id="trust" class="trust">
    <div class="container">
      <ul class="trust-list">
        {items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>
)}

<style>
  .trust {
    padding-top: 0;
    padding-bottom: 2em;
  }
</style>
