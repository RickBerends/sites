---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { strings } from '../config';

interface Props {
  heading?: string;
  body: string;
  image?: ImageMetadata;
}

const { heading, body, image } = Astro.props;
const isPlaceholder = !image;

// Split on blank lines so a multi-paragraph `about` renders as paragraphs
// rather than one wall of text.
const paragraphs = body.split(/\n\s*\n/).filter((p) => p.trim().length > 0);
---

<section id="about" class="section section-alt">
  <div class="container about-inner reveal">
    <div class="about-visual">
      {
        image ? (
          <Image src={image} alt={heading ?? strings.aboutHeading} widths={[400, 800, 1000]} sizes="(min-width: 900px) 40vw, 100vw" />
        ) : (
          // No confidently-licensed real photo of the salon/treatments was available in this
          // offline session — this gradient is a placeholder and must be swapped for a real
          // photo before launch.
          <div class="visual-placeholder" role="img" aria-label="" />
        )
      }
      {isPlaceholder && <p class="visual-caption">{strings.stockImageCaption}</p>}
    </div>

    <div class="about-copy">
      <h2>{heading ?? strings.aboutHeading}</h2>
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about-inner {
    display: grid;
    gap: 2rem;
    max-width: 68ch;
  }

  .about-inner p {
    font-size: 1.05rem;
  }

  .about-inner p:last-child {
    margin-bottom: 0;
  }

  .about-visual img,
  .visual-placeholder {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-card);
    display: block;
  }

  /* Same accent-token palette as the hero placeholder, in a quieter linear
     wash with a fine woven hairline texture — a nod to fabric/linen rather
     than a literal beauty-treatment cliché. */
  .visual-placeholder {
    position: relative;
    overflow: hidden;
    background: linear-gradient(
      190deg,
      color-mix(in srgb, var(--color-accent) 30%, var(--color-surface)),
      color-mix(in srgb, var(--color-accent-alt) 22%, var(--color-bg)) 75%
    );
    box-shadow: inset 0 0 0 1px var(--color-border);
  }

  .visual-placeholder::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      115deg,
      transparent 0,
      transparent 14px,
      color-mix(in srgb, var(--color-bg) 35%, transparent) 15px,
      transparent 16px
    );
  }

  .visual-caption {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  @media (min-width: 900px) {
    .about-inner {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: center;
      max-width: 1080px;
    }
  }
</style>
