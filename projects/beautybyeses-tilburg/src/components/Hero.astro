---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { strings, hasSection, telHref } from '../config';

interface Props {
  label?: string;
  heading: string;
  sub: string;
  phone?: string;
  image?: ImageMetadata;
}

const { label, heading, sub, phone, image } = Astro.props;
const isPlaceholder = !image;

// Secondary CTA points at hours if that section exists, otherwise contact —
// never at a section that isn't rendered.
const secondaryHref = hasSection('hours')
  ? '#hours'
  : hasSection('contact')
    ? '#contact'
    : null;
---

<section id="top" class="hero section">
  <div class="container hero-inner">
    <div class="hero-visual">
      {
        image ? (
          <Image src={image} alt={heading} widths={[400, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" />
        ) : (
          // No confidently-licensed real photo of the salon/treatments was available in this
          // offline session — this gradient is a placeholder and must be swapped for a real
          // photo before launch.
          <div class="visual-placeholder" role="img" aria-label="" />
        )
      }
      {isPlaceholder && <p class="visual-caption">{strings.stockImageCaption}</p>}
    </div>

    <div class="hero-copy">
      {label && <span class="eyebrow">{label}</span>}
      <h1>{heading}</h1>
      <p class="lead">{sub}</p>

      <div class="hero-ctas">
        {
          phone && (
            <a class="btn btn-primary" href={telHref(phone)}>
              {strings.primaryCta}
            </a>
          )
        }
        {
          secondaryHref && (
            <a class="btn btn-secondary" href={secondaryHref}>
              {strings.secondaryCta}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(
        60% 60% at 85% 0%,
        color-mix(in srgb, var(--color-accent) 14%, transparent),
        transparent 70%
      ),
      var(--color-bg);
  }

  .hero-inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    max-width: 1100px;
  }

  .hero-visual img,
  .visual-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
    display: block;
  }

  /* Soft duotone glow in the identity's own accent tokens, with a faint ring
     motif nodding to a lash curl — restrained rather than literal. */
  .visual-placeholder {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(
        85% 85% at 20% 20%,
        color-mix(in srgb, var(--color-accent) 45%, transparent),
        transparent 65%
      ),
      radial-gradient(
        75% 75% at 85% 90%,
        color-mix(in srgb, var(--color-accent-alt) 35%, transparent),
        transparent 65%
      ),
      linear-gradient(160deg, var(--color-surface), var(--color-bg));
    box-shadow: inset 0 0 0 1px var(--color-border);
  }

  .visual-placeholder::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-radial-gradient(
      circle at 50% 45%,
      transparent 0,
      transparent 22px,
      color-mix(in srgb, var(--color-text) 6%, transparent) 23px,
      transparent 24px
    );
  }

  .visual-caption {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
