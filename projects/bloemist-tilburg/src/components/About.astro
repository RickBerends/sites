---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import stockAbout from '../assets/stock/about.jpg';

interface Props {
  heading: string;
  about: string;
  image?: ImageMetadata;
}
const { heading, about, image } = Astro.props;
const isStock = !image;
const aboutImage = image ?? stockAbout;
---

<section id="over-ons" class="section fade-in about">
  <div class="about-visual">
    <Image src={aboutImage} alt={isStock ? '' : heading} widths={[400, 800, 1000]} sizes="(min-width: 900px) 40vw, 100vw" />
    {isStock && <p class="visual-caption">Sfeerbeeld — wordt vervangen zodra er eigen winkelfoto's zijn</p>}
  </div>
  <div class="about-copy">
    <span class="eyebrow">Over ons</span>
    <h2>{heading}</h2>
    <p>{about}</p>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 2rem;
  }

  .about-visual img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    display: block;
  }

  .visual-caption {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: center;
    }
  }
</style>
