---
interface Props {
  items?: string[];
}
const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <section class="trust section fade-in" aria-label="Waarom Bloem'ist">
    <ul class="trust-list">
      {items.map((item) => (
        <li>
          <span class="check" aria-hidden="true">&#10003;</span>
          {item}
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .trust {
    padding-top: 0;
    padding-bottom: 2rem;
  }

  .trust-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .trust-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    padding: 0.85rem 1rem;
  }

  .check {
    color: var(--color-accent);
    font-weight: 700;
  }
</style>
