---
interface Props {
  address?: string;
  mapQuery?: string;
}
const { address, mapQuery } = Astro.props;
const mapHref = mapQuery
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`
  : undefined;
---

{address && (
  <section id="locatie" class="section fade-in location">
    <div>
      <span class="eyebrow">Locatie</span>
      <h2>Midden in het centrum van Tilburg</h2>
      <p class="address">{address}</p>
      {mapHref && (
        <a class="btn btn-secondary" href={mapHref} target="_blank" rel="noopener noreferrer">
          Route plannen
        </a>
      )}
    </div>
  </section>
)}

<style>
  .location {
    padding-top: 0;
  }

  .address {
    font-size: 1.1rem;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }
</style>
