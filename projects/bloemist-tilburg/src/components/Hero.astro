---
interface Props {
  label: string;
  heading: string;
  sub: string;
  phone?: string;
}
const { label, heading, sub, phone } = Astro.props;
const telHref = phone ? `tel:${phone.replace(/\s+/g, '')}` : undefined;
---

<section id="top" class="hero section fade-in">
  <div class="hero-visual" aria-hidden="true">
    <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <circle cx="100" cy="100" r="70" fill="none" stroke="currentColor" stroke-width="1.2"/>
      <path d="M100 40 C 120 60, 120 90, 100 110 C 80 90, 80 60, 100 40 Z" fill="none" stroke="currentColor" stroke-width="1.2"/>
      <path d="M100 110 C 120 120, 140 120, 150 100 C 140 80, 120 80, 100 110 Z" fill="none" stroke="currentColor" stroke-width="1.2"/>
      <path d="M100 110 C 80 120, 60 120, 50 100 C 60 80, 80 80, 100 110 Z" fill="none" stroke="currentColor" stroke-width="1.2"/>
      <line x1="100" y1="110" x2="100" y2="165" stroke="currentColor" stroke-width="1.2"/>
    </svg>
    <p class="visual-caption">Sfeerbeeld — echte winkelfoto's volgen na klant­goedkeuring</p>
  </div>

  <div class="hero-copy">
    <span class="eyebrow">{label}</span>
    <h1>{heading}</h1>
    <p class="hero-sub">{sub}</p>
    <div class="hero-ctas">
      {telHref && <a class="btn btn-primary" href={telHref}>Bel nu</a>}
      <a class="btn btn-secondary" href="#openingstijden">Bekijk openingstijden</a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-top: 3rem;
  }

  .hero-visual {
    order: -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(160deg, var(--color-accent-alt-2) 0%, var(--color-accent-alt) 100%);
    border-radius: var(--radius-card);
    padding: 3rem 1.5rem;
    color: #fff;
    text-align: center;
  }

  .hero-visual svg {
    width: 120px;
    height: 120px;
    opacity: 0.9;
  }

  .visual-caption {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .hero-sub {
    max-width: 46ch;
    font-size: 1.1rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1fr 1fr;
    }
    .hero-visual {
      order: 1;
    }
  }
</style>
