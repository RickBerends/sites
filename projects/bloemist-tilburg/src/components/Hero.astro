---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import stockHero from '../assets/stock/hero.png';

interface Props {
  label: string;
  heading: string;
  sub: string;
  phone?: string;
  image?: ImageMetadata;
}
const { label, heading, sub, phone, image } = Astro.props;
const telHref = phone ? `tel:${phone.replace(/\s+/g, '')}` : undefined;
const isStock = !image;
const heroImage = image ?? stockHero;
---

<section id="top" class="hero section fade-in">
  <div class="hero-visual">
    <Image src={heroImage} alt={isStock ? '' : heading} widths={[400, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" />
    {isStock && <p class="visual-caption">Sfeerbeeld — wordt vervangen zodra er eigen winkelfoto's zijn</p>}
  </div>

  <div class="hero-copy">
    <span class="eyebrow">{label}</span>
    <h1>{heading}</h1>
    <p class="hero-sub">{sub}</p>
    <div class="hero-ctas">
      {telHref && <a class="btn btn-primary" href={telHref}>Bel nu</a>}
      <a class="btn btn-secondary" href="#openingstijden">Bekijk openingstijden</a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-top: 3rem;
  }

  .hero-visual {
    order: -1;
  }

  .hero-visual img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    display: block;
  }

  .visual-caption {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .hero-sub {
    max-width: 46ch;
    font-size: 1.1rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1fr 1fr;
    }
    .hero-visual {
      order: 1;
    }
  }
</style>
