---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Trust from '../components/Trust.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Location from '../components/Location.astro';
import Hours from '../components/Hours.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const pages = await getCollection('page');
const home = pages.find((p) => p.id === 'home')?.data;

if (!home) {
  throw new Error('src/content/home.md is missing or failed schema validation');
}

const title = 'Wereldwinkel Tilburg — Fair trade cadeaus & lekkernijen';
const description = 'Wereldwinkel Tilburg: fair trade cadeaus, koffie, thee en handgemaakte producten, vrijwillig gerund aan de Nieuwlandstraat in Tilburg.';
---
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <p class="draft-banner">Proof-of-concept ontwerp — nog niet bekrachtigd door de klant. Niet geïndexeerd door zoekmachines.</p>
    <Header />
    <main>
      <Hero heading={home.hero_heading} sub={home.hero_sub} phone={home.phone} />
      <Trust items={home.trust} />
      <Services services={home.services} />
      <About about={home.about} />
      <Location address={home.address} />
      <Hours hours={home.hours} />
      <Contact phone={home.phone} whatsapp={home.whatsapp} contact_email={home.contact_email} address={home.address} />
    </main>
    <Footer />
  </body>
</html>
