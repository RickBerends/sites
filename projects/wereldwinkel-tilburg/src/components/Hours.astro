---
interface Item { day: string; open: string; }
interface Props { hours?: Item[]; }
const { hours = [] } = Astro.props;
---
{hours.length > 0 && (
  <section id="openingstijden" class="hours">
    <div class="container hours-inner">
      <span class="section-label">Openingstijden</span>
      <h2>Wanneer we open zijn</h2>
      <table class="hours-table reveal">
        <tbody>
          {hours.map((h) => (
            <tr class={h.open === 'Gesloten' ? 'closed' : ''}>
              <th scope="row">{h.day}</th>
              <td>{h.open}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="hint">Loop gerust binnen — reserveren is niet nodig.</p>
    </div>
  </section>
)}

<style>
  .hours-inner {
    max-width: 520px;
  }
  .hours-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 2rem;
    font-size: 1.02rem;
  }
  .hours-table tr {
    border-bottom: 1px solid var(--color-border);
  }
  .hours-table th, .hours-table td {
    padding: 0.75em 0;
    text-align: left;
    font-weight: 500;
  }
  .hours-table th {
    color: var(--color-text);
  }
  .hours-table td {
    text-align: right;
    color: var(--color-text-secondary);
  }
  .hours-table tr.closed td {
    color: var(--color-text-secondary);
    font-style: italic;
  }
  .hint {
    margin-top: 1.5rem;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }
</style>
