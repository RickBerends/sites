---
interface Props {
  items?: string[];
}
const { items = [] } = Astro.props;
---
{items.length > 0 && (
  <section id="trust" class="trust">
    <div class="container">
      <ul class="trust-list reveal">
        {items.map((item) => (
          <li>
            <span class="check" aria-hidden="true">&#10003;</span> {item}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .trust {
    padding: 0 0 64px;
  }
  .trust-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin: 0;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .trust-list li {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
  }
  .check {
    color: var(--color-accent-contrast);
    font-weight: 700;
  }
</style>
