---
import { strings, hasSection, telHref } from '../config';

interface Props {
  label?: string;
  heading: string;
  sub: string;
  phone?: string;
}

const { label, heading, sub, phone } = Astro.props;

// Secondary CTA points at hours if that section exists, otherwise contact —
// never at a section that isn't rendered.
const secondaryHref = hasSection('hours')
  ? '#hours'
  : hasSection('contact')
    ? '#contact'
    : null;
---

<section id="top" class="hero section">
  <div class="container hero-inner">
    <div class="hero-copy">
      {label && <span class="eyebrow">{label}</span>}
      <h1>{heading}</h1>
      <p class="lead">{sub}</p>

      <div class="hero-ctas">
        {
          phone && (
            <a class="btn btn-primary" href={telHref(phone)}>
              {strings.primaryCta}
            </a>
          )
        }
        {
          secondaryHref && (
            <a class="btn btn-secondary" href={secondaryHref}>
              {strings.secondaryCta}
            </a>
          )
        }
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <span class="hero-visual-ring"></span>
      <span class="hero-visual-arc"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(
        60% 60% at 85% 0%,
        color-mix(in srgb, var(--color-accent) 14%, transparent),
        transparent 70%
      ),
      var(--color-bg);
  }

  .hero-inner {
    display: grid;
    gap: 3rem;
    align-items: center;
    max-width: 1080px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  /* Crafted CSS visual — a soft, boutique-feeling companion to the copy rather
     than a literal photo. Layered warm/sage gradients evoke daylight and
     fabric; the thin ring and crescent nod to a manicured nail tip without
     being a literal icon. Restrained on purpose: one accent, no gradients on
     buttons, nothing that competes with the copy. */
  .hero-visual {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    overflow: hidden;
    background:
      radial-gradient(
        120% 90% at 20% 15%,
        color-mix(in srgb, var(--color-accent) 22%, var(--color-surface)),
        transparent 60%
      ),
      radial-gradient(
        90% 80% at 85% 90%,
        color-mix(in srgb, var(--color-accent-alt) 26%, var(--color-surface)),
        transparent 65%
      ),
      linear-gradient(
        160deg,
        var(--color-surface),
        color-mix(in srgb, var(--color-bg) 60%, var(--color-surface))
      );
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--color-border);
  }

  .hero-visual-ring {
    position: absolute;
    top: 12%;
    right: 10%;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    opacity: 0.6;
  }

  /* A slender crescent — the curve of a manicured nail tip, rendered purely
     in CSS via an off-center radius, not an icon font or SVG import. */
  .hero-visual-arc {
    position: absolute;
    left: 8%;
    bottom: 10%;
    width: 62%;
    aspect-ratio: 0.82;
    border-radius: 45% 55% 60% 40% / 55% 45% 55% 45%;
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-visual-ring,
    .hero-visual-arc {
      transition: transform var(--motion-duration) var(--motion-ease);
    }
  }
</style>
