---
import { strings } from '../config';

interface Props {
  hours?: { day: string; open: string }[];
}

const { hours = [] } = Astro.props;
---

{
  hours.length > 0 && (
    <section id="hours" class="section section-alt">
      <div class="container hours-inner reveal">
        <h2>{strings.hoursHeading}</h2>
        <table>
          <tbody>
            {hours.map((entry) => (
              <tr>
                <th scope="row">{entry.day}</th>
                <td class={entry.open === strings.closedLabel ? 'is-closed' : ''}>
                  {entry.open}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )
}

<style>
  .hours-inner {
    max-width: 460px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1.5rem;
  }

  th,
  td {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    font-weight: 400;
  }

  th {
    color: var(--color-text);
  }

  td {
    text-align: right;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .is-closed {
    opacity: 0.65;
  }
</style>
