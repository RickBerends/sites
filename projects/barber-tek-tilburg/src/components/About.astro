---
import { Image } from 'astro:assets';
import aboutImg from '../assets/about.jpg';

interface Props {
  text: string;
}
const { text } = Astro.props;
---
<section id="over-ons" class="about">
  <div class="container about-inner">
    <div class="about-visual fade-up">
      <Image
        src={aboutImg}
        alt="Barbier die met schaar en kam het haar van een klant bijknipt"
        widths={[400, 800, 1000]}
        sizes="(min-width: 900px) 38vw, 100vw"
      />
      <p class="visual-caption">Sfeerbeeld — wordt vervangen zodra er eigen foto's van de zaak zijn</p>
    </div>
    <div class="about-copy">
      <p class="eyebrow">Over de zaak</p>
      <h2>Barber Tek</h2>
      <p class="about-body fade-up">{text}</p>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-surface);
  }

  .about-inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    max-width: 1000px;
  }

  .about-body {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    white-space: pre-line;
  }

  .about-visual img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    display: block;
  }

  .visual-caption {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 800px) {
    .about-inner {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
</style>
