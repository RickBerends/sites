---
interface Props {
  items?: string[];
}
const { items } = Astro.props;
---
{items && items.length > 0 && (
  <section class="trust" aria-label="Kenmerken">
    <div class="container trust-inner">
      {items.map((item) => (
        <p class="trust-item fade-up">
          <span aria-hidden="true">✓</span> {item}
        </p>
      ))}
    </div>
  </section>
)}

<style>
  .trust {
    padding-top: 0;
    padding-bottom: 2.5rem;
  }

  @media (min-width: 900px) {
    .trust {
      padding-top: 0;
      padding-bottom: 3rem;
    }
  }

  .trust-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
  }

  .trust-item {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .trust-item span {
    color: var(--color-accent);
  }
</style>
