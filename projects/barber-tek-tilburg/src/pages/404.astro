---
import '../styles/global.css';
import DraftBanner from '../components/DraftBanner.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pagina niet gevonden — Barber Tek</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <DraftBanner />
    <Nav />
    <section class="not-found">
      <div class="container fade-up">
        <p class="eyebrow">404</p>
        <h1>Deze pagina bestaat niet</h1>
        <p>
          Misschien is de link verkeerd getypt. Ga terug naar de homepage om
          Barber Tek's diensten, openingstijden en contactgegevens te vinden.
        </p>
        <a class="btn btn-primary" href={base}>Terug naar de homepage</a>
      </div>
    </section>
    <Footer />
  </body>
</html>

<style>
  .not-found {
    min-height: 50vh;
    display: flex;
    align-items: center;
  }

  .not-found p:not(.eyebrow) {
    color: var(--color-text-muted);
    max-width: 48ch;
    margin-bottom: 1.5rem;
  }
</style>
