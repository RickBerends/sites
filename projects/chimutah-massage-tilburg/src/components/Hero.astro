---
import { strings, hasSection, telHref } from '../config';

interface Props {
  label?: string;
  heading: string;
  sub: string;
  phone?: string;
}

const { label, heading, sub, phone } = Astro.props;

// Secondary CTA points at hours if that section exists, otherwise contact —
// never at a section that isn't rendered.
const secondaryHref = hasSection('hours')
  ? '#hours'
  : hasSection('contact')
    ? '#contact'
    : null;
---

<section id="top" class="hero section">
  <div class="container hero-inner">
    <div class="hero-copy">
      {label && <span class="eyebrow">{label}</span>}
      <h1>{heading}</h1>
      <p class="lead">{sub}</p>

      <div class="hero-ctas">
        {
          phone && (
            <a class="btn btn-primary" href={telHref(phone)}>
              {strings.primaryCta}
            </a>
          )
        }
        {
          secondaryHref && (
            <a class="btn btn-secondary" href={secondaryHref}>
              {strings.secondaryCta}
            </a>
          )
        }
      </div>
    </div>

    {
      /* No landscape photo of this practice exists yet, so the hero visual is a
         crafted CSS gradient panel rather than a stock stand-in — soft layered
         glow, a thin ring and a fine grain, built from the identity's own accent
         tokens. Purely decorative, so it's hidden from assistive tech. */
    }
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-visual-glow"></div>
      <div class="hero-visual-ring"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(
        60% 60% at 85% 0%,
        color-mix(in srgb, var(--color-accent) 14%, transparent),
        transparent 70%
      ),
      var(--color-bg);
  }

  .hero-inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    max-width: 1100px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  /* Calm, restrained wellness visual: two soft radial washes of the accent
     colours over a warm surface gradient, a breathing glow and a thin ring —
     evokes candlelight / warm oil / soft focus without any literal imagery. */
  .hero-visual {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    background:
      radial-gradient(
        60% 60% at 28% 24%,
        color-mix(in srgb, var(--color-accent) 30%, transparent),
        transparent 70%
      ),
      radial-gradient(
        55% 55% at 76% 72%,
        color-mix(in srgb, var(--color-accent-alt) 34%, transparent),
        transparent 70%
      ),
      linear-gradient(160deg, var(--color-surface), var(--color-bg));
  }

  .hero-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      color-mix(in srgb, var(--color-text) 6%, transparent) 1px,
      transparent 1px
    );
    background-size: 14px 14px;
    opacity: 0.5;
  }

  .hero-visual-glow {
    position: absolute;
    inset: 16%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-bg) 65%, transparent),
      transparent 72%
    );
    filter: blur(6px);
    animation: heroGlowBreathe 6s var(--motion-ease) infinite;
  }

  .hero-visual-ring {
    position: absolute;
    inset: 26%;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  @keyframes heroGlowBreathe {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.9;
    }
    50% {
      transform: scale(1.06);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-visual-glow {
      animation: none;
    }
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
