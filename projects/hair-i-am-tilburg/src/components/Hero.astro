---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { strings, hasSection, telHref } from '../config';

interface Props {
  label?: string;
  heading: string;
  sub: string;
  phone?: string;
  image?: ImageMetadata;
}

const { label, heading, sub, phone, image } = Astro.props;

// Secondary CTA points at hours if that section exists, otherwise contact —
// never at a section that isn't rendered.
const secondaryHref = hasSection('hours')
  ? '#hours'
  : hasSection('contact')
    ? '#contact'
    : null;
---

<section id="top" class="hero section">
  <div class="container hero-inner">
    <div class="hero-visual">
      {
        image ? (
          <Image
            src={image}
            alt="Sfeerbeeld van de haarstudio Hair I Am in Tilburg"
            widths={[400, 800, 1200]}
            sizes="(min-width: 900px) 50vw, 100vw"
          />
        ) : (
          <div class="visual-art" aria-hidden="true">
            <span class="visual-art-ring"></span>
          </div>
        )
      }
      {
        !image && (
          <p class="visual-caption">
            Sfeerbeeld — wordt vervangen zodra er eigen foto's van de salon zijn
          </p>
        )
      }
    </div>

    <div class="hero-copy">
      {label && <span class="eyebrow">{label}</span>}
      <h1>{heading}</h1>
      <p class="lead">{sub}</p>

      <div class="hero-ctas">
        {
          phone && (
            <a class="btn btn-primary" href={telHref(phone)}>
              {strings.primaryCta}
            </a>
          )
        }
        {
          secondaryHref && (
            <a class="btn btn-secondary" href={secondaryHref}>
              {strings.secondaryCta}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(
        60% 60% at 85% 0%,
        color-mix(in srgb, var(--color-accent) 14%, transparent),
        transparent 70%
      ),
      var(--color-bg);
  }

  .hero-inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    max-width: 1100px;
  }

  .hero-visual {
    order: -1;
  }

  .hero-visual :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    display: block;
    box-shadow: var(--shadow-soft);
  }

  /* Crafted placeholder visual — built entirely from identity-B accent
     tokens, no stock photography. The two mock barbershop photos available
     in this environment read as generic masculine barbershop (moody
     lighting, exposed brick, a light-skinned client's beard trim) rather
     than this studio's afro/black-hair specialty or its soft-boutique
     identity, so this gradient stands in until a real salon photo exists. */
  .visual-art {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    background:
      radial-gradient(
        120% 140% at 12% 8%,
        color-mix(in srgb, var(--color-accent) 55%, var(--color-bg)) 0%,
        transparent 55%
      ),
      radial-gradient(
        120% 140% at 88% 92%,
        color-mix(in srgb, var(--color-accent-alt) 50%, var(--color-bg)) 0%,
        transparent 60%
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-accent) 20%, var(--color-surface)),
        color-mix(in srgb, var(--color-accent-alt) 16%, var(--color-surface))
      );
  }

  .visual-art::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      color-mix(in srgb, var(--color-bg) 65%, transparent) 1px,
      transparent 1.5px
    );
    background-size: 15px 15px;
    opacity: 0.2;
    mix-blend-mode: overlay;
  }

  .visual-art-ring {
    position: absolute;
    inset: 14%;
    border: 1px solid color-mix(in srgb, var(--color-bg) 70%, transparent);
    border-radius: 50%;
    opacity: 0.4;
  }

  .visual-caption {
    margin-top: 0.6rem;
    margin-bottom: 0;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr 1fr;
    }

    .hero-visual {
      order: 1;
    }
  }
</style>
