---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { strings } from '../config';

interface Props {
  heading?: string;
  body: string;
  image?: ImageMetadata;
}

const { heading, body, image } = Astro.props;

// Split on blank lines so a multi-paragraph `about` renders as paragraphs
// rather than one wall of text.
const paragraphs = body.split(/\n\s*\n/).filter((p) => p.trim().length > 0);
---

<section id="about" class="section section-alt">
  <div class="container about-grid reveal">
    <div class="about-visual">
      {
        image ? (
          <Image
            src={image}
            alt="Interieur van haarstudio Hair I Am aan de Besterdring in Tilburg"
            widths={[400, 800, 1000]}
            sizes="(min-width: 900px) 40vw, 100vw"
          />
        ) : (
          <div class="visual-art" aria-hidden="true">
            <span class="visual-art-block"></span>
          </div>
        )
      }
      {
        !image && (
          <p class="visual-caption">
            Sfeerbeeld — wordt vervangen zodra er eigen foto's van de salon zijn
          </p>
        )
      }
    </div>

    <div class="about-inner">
      <h2>{heading ?? strings.aboutHeading}</h2>
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: 2.5rem;
  }

  .about-inner {
    max-width: 68ch;
  }

  .about-inner p {
    font-size: 1.05rem;
  }

  .about-inner p:last-child {
    margin-bottom: 0;
  }

  .about-visual :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    display: block;
    box-shadow: var(--shadow-soft);
  }

  /* Crafted placeholder visual, distinct from the Hero's — portrait
     orientation, reversed accent order — built from the same identity-B
     tokens. See Hero.astro for why no stock photo is used here either. */
  .visual-art {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    background:
      radial-gradient(
        130% 110% at 85% 10%,
        color-mix(in srgb, var(--color-accent-alt) 50%, var(--color-bg)) 0%,
        transparent 55%
      ),
      radial-gradient(
        130% 110% at 15% 95%,
        color-mix(in srgb, var(--color-accent) 55%, var(--color-bg)) 0%,
        transparent 60%
      ),
      linear-gradient(
        200deg,
        color-mix(in srgb, var(--color-accent-alt) 18%, var(--color-surface)),
        color-mix(in srgb, var(--color-accent) 20%, var(--color-surface))
      );
  }

  .visual-art::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      color-mix(in srgb, var(--color-bg) 65%, transparent) 1px,
      transparent 1.5px
    );
    background-size: 15px 15px;
    opacity: 0.2;
    mix-blend-mode: overlay;
  }

  .visual-art-block {
    position: absolute;
    inset: 16% 20%;
    border: 1px solid color-mix(in srgb, var(--color-bg) 70%, transparent);
    border-radius: var(--radius-card);
    opacity: 0.4;
  }

  .visual-caption {
    margin-top: 0.6rem;
    margin-bottom: 0;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: center;
    }
  }
</style>
