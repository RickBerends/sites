---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, hasSection } from '../config';

import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Trust from '../components/Trust.astro';
import Services from '../components/Services.astro';
import Projects from '../components/Projects.astro';
import Highlights from '../components/Highlights.astro';
import About from '../components/About.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import Location from '../components/Location.astro';
import Hours from '../components/Hours.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const entry = await getEntry('page', 'home');
if (!entry) {
  throw new Error('Missing src/content/home.md');
}
const data = entry.data;

// <head> copy lives in home.md so it stays with the rest of the content — and so
// Decap can edit it in Part 2 without touching a component.
const title = data.seo_title ?? `${site.name} — ${data.hero_heading}`;
const description = data.seo_description ?? data.hero_sub;
---

<BaseLayout title={title} description={description}>
  <Header phone={data.phone} />

  <main id="main">
    {
      hasSection('hero') && (
        <Hero
          label={data.hero_label}
          heading={data.hero_heading}
          sub={data.hero_sub}
          phone={data.phone}
          image={data.hero_image}
        />
      )
    }
    {hasSection('trust') && <Trust items={data.trust} />}
    {hasSection('services') && <Services services={data.services} />}
    {
      hasSection('projects') && (
        <Projects heading={data.projects_heading} items={data.projects} />
      )
    }
    {
      hasSection('highlights') && (
        <Highlights heading={data.highlights_heading} items={data.highlights} />
      )
    }
    {
      hasSection('about') && (
        <About heading={data.about_heading} body={data.about} image={data.about_image} />
      )
    }
    {
      hasSection('process') && <Process heading={data.process_heading} steps={data.process} />
    }
    {
      hasSection('testimonials') && (
        <Testimonials testimonials={data.testimonials} source={data.testimonials_source} />
      )
    }
    {hasSection('location') && <Location address={data.address} mapsUrl={data.maps_url} />}
    {hasSection('hours') && <Hours hours={data.hours} />}
    {
      hasSection('contact') && (
        <Contact
          phone={data.phone}
          whatsapp={data.whatsapp}
          email={data.contact_email}
          address={data.address}
        />
      )
    }
  </main>

  <Footer instagramUrl={data.instagram_url} facebookUrl={data.facebook_url} />
</BaseLayout>
